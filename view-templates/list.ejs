<%
/**
 * Shared list view for home / category / tag / archive.
 *
 * Structure ported from innei.in/categories/tech:
 *   eyebrow  ->  big count + "篇 · 始于 YYYY 年"  ->  title  ->  short accent rule
 *   then a year-grouped list of rows:  title | #tag, #tag +N | date
 *
 * Replaces the theme's card list and archive timeline so the list pages speak
 * the same visual language as the article page.
 */

  var allPosts = site.posts ? site.posts.toArray() : [];

  var posts = page.posts ? page.posts.toArray() : allPosts.slice();
  posts.sort(function (a, b) { return b.date.valueOf() - a.date.valueOf(); });

  /* earliest year across the whole site, for "始于 YYYY 年" */
  var earliest = '';
  if (allPosts.length) {
    var min = allPosts[0].date.valueOf();
    allPosts.forEach(function (p) { if (p.date.valueOf() < min) min = p.date.valueOf(); });
    earliest = date(min, 'YYYY');
  }

  var isCatIndex = !!(page.index && page.layout === 'category');
  var isTagIndex = !!(page.index && page.layout === 'tag');
  var isCategory = !!page.category;
  var isTag = !!page.tag;
  var isArchive = !!page.archive && !isCategory && !isTag;

  var eyebrow = '全部文章';
  var title = '';
  if (isCatIndex) { eyebrow = '分类'; title = '全部主题'; }
  else if (isTagIndex) { eyebrow = '标签'; title = '全部标签'; }
  else if (isCategory) { eyebrow = '分类'; title = page.category; }
  else if (isTag) { eyebrow = '标签'; title = page.tag; }
  else if (isArchive) {
    eyebrow = '归档';
    title = page.year
      ? (page.year + (page.month ? ' 年 ' + page.month + ' 月' : ' 年'))
      : '全部文章';
  }

  /* group this page's posts by year, newest year first */
  var groups = [];
  var seen = null;
  posts.forEach(function (p) {
    var y = date(p.date, 'YYYY');
    if (!seen || seen.year !== y) { seen = { year: y, posts: [] }; groups.push(seen); }
    seen.posts.push(p);
  });

  var siteCategories = site.categories ? site.categories.toArray() : [];
  var siteTags = site.tags ? site.tags.toArray() : [];
  siteCategories.sort(function (a, b) { return b.length - a.length; });
  siteTags.sort(function (a, b) { return b.length - a.length; });

  /* Categories here are hierarchical, so a bare name can repeat (AI at the
     root and AI under Agent are different buckets). Show the full path as
     "父级 / 子级" so the two rows are distinguishable. Tags are flat. */
  function catLabel(c) {
    var segs = String(c.path || '').replace(/^categories\//, '').replace(/\/$/, '')
      .split('/').filter(Boolean).map(decodeURIComponent);
    return segs.length ? segs.join(' / ') : c.name;
  }

  var indexMode = isCatIndex || isTagIndex;
  var totalCount = isCatIndex ? siteCategories.length
                 : isTagIndex ? siteTags.length
                 : posts.length;
%>
<div id="l_main" class="yh-list-page">
<header class="yh-list-head">
  <div class="yh-list-eyebrow"><%= eyebrow %></div>
  <div class="yh-list-count">
    <span class="yh-list-num"><%= totalCount %></span>
    <span class="yh-list-unit"><%= indexMode ? '个' : '篇' %><% if (!indexMode && earliest) { %> · 始于 <%= earliest %> 年<% } %></span>
  </div>
  <% if (title) { %><h1 class="yh-list-title"><%= title %></h1><% } %>
  <div class="yh-list-rule"></div>
</header>

<ul class="yh-list">
  <% if (indexMode) { %>
    <% (isCatIndex ? siteCategories : siteTags).forEach(function (item) { %>
      <li class="yh-list-item">
        <a class="yh-row" href="<%= url_for(item.path) %>">
          <span class="yh-row-title">#<%= isCatIndex ? catLabel(item) : item.name %></span>
          <span class="yh-row-meta">
            <span class="yh-row-tags"></span>
            <span class="yh-row-date"><%= item.length %> 篇</span>
          </span>
        </a>
      </li>
    <% }); %>
  <% } else { %>
    <% groups.forEach(function (g) { %>
      <li class="yh-list-year">
        <span class="yh-year"><%= g.year %></span>
        <span class="yh-year-count"><%= g.posts.length %> 篇</span>
      </li>
      <% g.posts.forEach(function (p) {
           var tags = p.tags ? p.tags.toArray() : [];
      %>
        <li class="yh-list-item">
          <a class="yh-row" href="<%= url_for(p.link || p.path) %>">
            <span class="yh-row-title"><%= p.title || p.seo_title || date(p.date, 'YYYY-MM-DD') %></span>
            <span class="yh-row-meta">
              <% if (tags.length) { %>
                <span class="yh-row-tags"><% tags.slice(0, 2).forEach(function (t, i) { %><% if (i) { %><span class="yh-tag-sep">, </span><% } %><span class="yh-tag">#<%= t.name %></span><% }); %><% if (tags.length > 2) { %><span class="yh-more"> +<%= tags.length - 2 %></span><% } %></span>
              <% } %>
              <span class="yh-row-date"><%= date(p.date, 'M月D日') %></span>
            </span>
          </a>
        </li>
      <% }); %>
    <% }); %>
  <% } %>
</ul>
</div>
